# apps/server
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mappin
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
PUBLIC_WEB_URL=http://localhost:3000
# openfreemap(기본, 실제 지도 타일) | demo(오프라인 데모 지도: pnpm demo:basemap 먼저 실행)
MAP_STYLE=openfreemap
# 선택: 카카오 키가 있으면 국내 지도/검색이 카카오로 전환됨 (docs/02)
KAKAO_JS_KEY=
KAKAO_REST_KEY=
# 선택: Google 로그인 (쉼표 구분 client id)
GOOGLE_CLIENT_IDS=
# apps/web
API_URL=http://127.0.0.1:8080
