{
  "name": "mappin",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @mappin/server --filter @mappin/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint:api": "redocly lint api/openapi.yaml",
    "gen:api": "pnpm --filter @mappin/api-client gen",
    "db:migrate": "pnpm --filter @mappin/server migrate",
    "demo:basemap": "node scripts/fetch-demo-basemap.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.3",
    "typescript": "5.6.3"
  }
}
