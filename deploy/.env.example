# ── 필수 ──────────────────────────────────────────
# 서비스 도메인 (DNS A 레코드가 이 서버 IP를 가리켜야 HTTPS 인증서가 발급됨)
DOMAIN=map.example.com
PUBLIC_WEB_URL=https://map.example.com
# setup.sh가 자동 생성 (직접 만들려면: openssl rand -base64 48)
POSTGRES_PASSWORD=
JWT_SECRET=

# ── 도메인 없이 IP로 먼저 시험할 때 ─────────────────
# DOMAIN=:80
# PUBLIC_WEB_URL=http://서버IP
# COOKIE_SECURE=false        # HTTPS가 아니면 false (운영에서는 절대 false 금지)
COOKIE_SECURE=true

# 이미 nginx 등이 80/443을 쓰고 있다면 다른 포트로 (docs/08 §6 참고)
# HTTP_PORT=8081
# HTTPS_PORT=8443

# ── 선택 ──────────────────────────────────────────
# 비밀번호 재설정·이메일 인증 메일 (없으면 API 로그에만 출력)
# 예: smtps://user:password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Mappin <no-reply@map.example.com>
# 카카오 키를 넣으면 국내 지도/장소 검색이 카카오로 전환 (docs/02)
KAKAO_JS_KEY=
KAKAO_REST_KEY=
GOOGLE_CLIENT_IDS=
MAP_STYLE=openfreemap
